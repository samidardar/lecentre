# ===== CallWiz AI — configuration (copier en .env : `callwiz init`) =====
ENVIRONMENT=dev
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000          # URL publique (tunnel ngrok/cloudflared en réel, pour Twilio)
JWT_SECRET=change-me
CORS_ORIGIN_REGEX=https://.*\.lovable\.app|https://.*\.lovableproject\.com|http://localhost(:\d+)?

# Données (défaut : SQLite local ; prod : postgresql+asyncpg://user:pass@host/db)
DATABASE_URL=sqlite+aiosqlite:///./callwiz.db
REDIS_URL=                                      # vide = bus mémoire mono-process ; redis://localhost:6379/0 en multi-process
DATA_DIR=./data
RETENTION_DAYS=90

# Voix / LLM — Gemini Live (audio natif)
LIVE_PROVIDER=mock                              # mock | gemini
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite         # analyse post-appel
GEMINI_DEFAULT_VOICE=Sulafat                    # voix FR conseillées : Sulafat (chaleureuse), Achird (amicale), Kore (ferme), Charon (posée)
DEFAULT_LANGUAGE=fr                             # langue par défaut des organisations (fr | en)
LIVE_LANGUAGE_LOCK=true                         # l'agent reste en français même si l'appelant change de langue
LIVE_SEND_LANGUAGE_CODE=false                   # envoie aussi fr-FR au modèle (à activer seulement si le modèle l'accepte)
LIVE_AFFECTIVE_DIALOG=false                     # ton adapté à l'émotion de l'appelant (API v1beta)
LIVE_SILENCE_DURATION_MS=350
LIVE_START_SENSITIVITY=HIGH
LIVE_END_SENSITIVITY=HIGH

# Télécom
TELEPHONY_PROVIDER=mock                         # mock | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_FROM=
TELEPHONY_CALLS_PER_SECOND=5
GLOBAL_MAX_CONCURRENT_CALLS=100

# RAG
VECTOR_STORE=qdrant_local                       # qdrant_local (embarqué, sans serveur) | qdrant | memory
QDRANT_URL=
EMBEDDER=fastembed                              # fastembed (local) | gemini | hashing (offline)
RAG_TOP_K=4

# MCP (outils externes des agents)
MCP_SERVERS_JSON={}

# Compte de démo créé par `callwiz db seed` (identifiants de test, local uniquement)
SEED_ADMIN_EMAIL=demo@callwiz.example.com
SEED_ADMIN_PASSWORD=callwiz-demo-2026
