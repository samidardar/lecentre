# ===== CallWiz AI — configuration (copier en .env : `callwiz init`) =====
ENVIRONMENT=dev
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000          # URL publique (tunnel ngrok/cloudflared en réel, pour Twilio)
JWT_SECRET=change-me
CORS_ORIGIN_REGEX=https://.*\.lovable\.app|https://.*\.lovableproject\.com|http://localhost(:\d+)?

# Données (défaut : SQLite local ; prod : postgresql+asyncpg://user:pass@host/db)
DATABASE_URL=sqlite+aiosqlite:///./callwiz.db
REDIS_URL=                                      # vide = bus mémoire mono-process ; redis://localhost:6379/0 en multi-process
DATA_DIR=./data
RETENTION_DAYS=90

# Voix / LLM — pipeline « cascade » (recommandé) : Deepgram (écoute) → Claude (réflexion) → Fish Audio (voix)
LIVE_PROVIDER=mock                              # mock | cascade | gemini
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=                         # requis si la clé n'est rattachée à aucun workspace (wrkspc_…)
LLM_MODEL=claude-haiku-4-5                      # conversation temps réel (latence minimale)
ANALYSIS_MODEL=claude-haiku-4-5                 # analyse de fin d'appel
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
FISH_API_KEY=
FISH_MODEL=s2.1-pro                             # s2.1-pro (payant) | s2.1-pro-free (gratuit, tests)
FISH_VOICE_ID=5567200c7d8341738f0892bbacd3be3c  # reference_id Fish Audio (voir GET /api/v1/organizations/voices)
FISH_LATENCY=low
DEFAULT_LANGUAGE=fr
LIVE_LANGUAGE_LOCK=true

# Option alternative : Gemini Live (audio natif)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_DEFAULT_VOICE=Sulafat

# Télécom
TELEPHONY_PROVIDER=mock                         # mock | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_FROM=
TELEPHONY_CALLS_PER_SECOND=5
GLOBAL_MAX_CONCURRENT_CALLS=100

# RAG
VECTOR_STORE=qdrant_local                       # qdrant_local (embarqué, sans serveur) | qdrant | memory
QDRANT_URL=
EMBEDDER=fastembed                              # fastembed (local) | gemini | hashing (offline)
RAG_TOP_K=4

# MCP (outils externes des agents)
MCP_SERVERS_JSON={}

# Compte de démo créé par `callwiz db seed` (identifiants de test, local uniquement)
SEED_ADMIN_EMAIL=demo@callwiz.example.com
SEED_ADMIN_PASSWORD=callwiz-demo-2026
